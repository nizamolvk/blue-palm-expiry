<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_expiry" model="ir.module.category">
        <field name="name">Expiry Tracker</field>
    </record>

    <record id="group_expiry_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_expiry"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="expiry_item_company_rule" model="ir.rule">
        <field name="name">Expiry items: own companies</field>
        <field name="model_id" ref="model_blue_palm_expiry_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
